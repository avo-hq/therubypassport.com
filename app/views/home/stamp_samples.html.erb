<!-- Inspiration Section -->
<section class="section-alternate py-20 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-6">
      <%= t('.inspiration.heading') %>
    </h2>

    <p class="text-lg text-slate-600 leading-relaxed mb-8">
      <%= t('.inspiration.description') %>
    </p>

    <div class="bg-white rounded-lg p-8 shadow-sm text-left">
      <h3 class="text-xl font-semibold text-slate-800 mb-4"><%= t('.inspiration.design_tips_heading') %></h3>
      <ul class="space-y-3 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span><%= t('.inspiration.tip_event_name') %></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span><%= t('.inspiration.tip_logo') %></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span><%= t('.inspiration.tip_dual_color') %></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span><%= t('.inspiration.tip_unique') %></span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span><%= t('.inspiration.tip_test') %></span>
        </li>
      </ul>
    </div>

    <div class="mt-12">
      <a href="<%= organizer_path %>" class="btn-primary">
        <span>📂</span>
        <span><%= t('.inspiration.organizer_guide') %></span>
      </a>
    </div>
  </div>
</section>

<%= render "layouts/footer", back_path: root_path, back_label: t("layouts.footer.back_to_home") %>
