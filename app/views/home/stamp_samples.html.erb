        </div>
        <div class="stamp-info">
          <h3 class="stamp-title">Paris.rb</h3>
          <p class="stamp-description">Elegant design with event branding</p>
        </div>
      </div>

      <!-- Munich Rubyshift Stamp -->
      <div class="stamp-card group">
        <div class="stamp-image-wrapper">
          <img 
            src="https://therubypassport.notion.site/image/attachment%3A28404a81-2e49-4db8-8736-91512520308a%3Amunich-rubyshift.jpg?table=block&id=2e82f15f-796c-802f-b362-fbb9a2dd106c&spaceId=055e1701-358d-48cc-a4d8-48ad8f86365a&width=140&userId=&cache=v2" 
