<!-- Inspiration Section -->
<section class="section-alternate py-20 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-6">
      Get Creative with Your Stamp
    </h2>

    <p class="text-lg text-slate-600 leading-relaxed mb-8">
      These examples show the variety of designs possible. Your stamp can be simple or elaborate, colorful or monochrome, round or custom-shaped. The only limit is your imagination!
    </p>

    <div class="bg-white rounded-lg p-8 shadow-sm text-left">
      <h3 class="text-xl font-semibold text-slate-800 mb-4">Design Tips:</h3>
      <ul class="space-y-3 text-slate-600">
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span>Include your event name and year</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span>Add your logo or a Ruby-themed icon</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span>Consider dual-color designs for visual impact</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span>Make it unique to your event's personality</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[#9b1c31] font-bold">•</span>
          <span>Test the stamp on paper before the event</span>
        </li>
      </ul>
    </div>

    <div class="mt-12">
      <a href="<%= organizer_path %>" class="btn-primary">
        <span>📂</span>
        <span>View Organizer's Guide</span>
      </a>
    </div>
  </div>
</section>

<%= render "layouts/footer", back_path: root_path, back_label: t("layouts.footer.back_to_home") %>
