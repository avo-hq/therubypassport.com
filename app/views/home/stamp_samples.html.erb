<% content_for(:title) { "Stamp Samples — Ruby Passport" } %>

<!-- Hero Section -->
<section class="min-h-[50vh] flex flex-col items-center justify-center px-6 py-16 bg-gradient-to-b from-slate-50 to-white">
  <div class="max-w-4xl mx-auto text-center">
    <div class="mb-8">
      <span class="text-6xl">📋</span>
    </div>
    
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-800 mb-6 leading-tight">
      Stamp Samples
    </h1>

    <p class="text-xl md:text-2xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
      Get inspired by stamps from Ruby events around the world. These examples show the creativity and variety possible with event stamps.
    </p>
  </div>
</section>

<!-- Gallery Section -->
<section class="py-20 px-6 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Ruby 30 Stamp -->
      <div class="stamp-card group">
        <div class="stamp-image-wrapper">
          <img 
            src="https://therubypassport.notion.site/image/attachment%3Ac8a0dd05-dfd3-43fa-9ca8-b5db43554fe8%3Aruby-30-stamp.jpg?table=block&id=2cc2f15f-796c-80d1-851a-cc09d6313089&spaceId=055e1701-358d-48cc-a4d8-48ad8f86365a&width=370&userId=&cache=v2" 
            alt="Ruby 30 stamp"
            class="stamp-image"
            loading="lazy"
          >
        </div>
        <div class="stamp-info">
          <h3 class="stamp-title">Ruby 30</h3>
          <p class="stamp-description">Classic circular design with Ruby logo</p>
        </div>
      </div>

      <!-- Paris.rb Stamp -->
      <div class="stamp-card group">
        <div class="stamp-image-wrapper">
