<label class="flex items-start gap-3 p-4 bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow cursor-pointer print:shadow-none print:p-2 print:border print:border-slate-200">
  <input
    type="checkbox"
    data-checklist-target="item"
    data-checklist-key="<%= key %>"
    data-action="checklist#toggle"
    class="mt-1 h-5 w-5 rounded border-slate-300 text-[#9b1c31] focus:ring-[#9b1c31] shrink-0 print:h-4 print:w-4"
  >
  <span class="text-lg text-slate-700 leading-snug print:text-sm"><%= label %></span>
</label>
