<% content_for(:title) { t('.title') } %>

<!-- Hero Section -->
<section class="min-h-[60vh] flex flex-col items-center justify-center px-6 py-16 bg-gradient-to-b from-slate-50 to-white">
  <div class="max-w-4xl mx-auto text-center">
    <div class="mb-8">
      <span class="text-6xl">🗂️</span>
    </div>

    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-800 mb-6 leading-tight">
      <%= t('.hero.heading') %><br>
      <span class="text-3xl md:text-4xl text-slate-600 font-normal"><%= t('.hero.subheading') %></span>
    </h1>

    <div class="status-callout inline-flex items-center gap-3 px-6 py-4 mb-8">
      <span class="text-2xl">🛠</span>
      <div class="text-left">
        <span class="font-semibold text-amber-800"><%= t('.hero.callout') %></span>
      </div>
    </div>

    <!-- Quick Navigation -->
    <nav class="flex flex-wrap justify-center gap-3 text-sm mb-8">
      <a href="#tldr" class="text-[#9b1c31] hover:underline font-medium"><%= t('.hero.nav_tldr') %></a>
      <span class="text-slate-300">•</span>
      <a href="#faq" class="text-[#9b1c31] hover:underline font-medium"><%= t('.hero.nav_faq') %></a>
      <span class="text-slate-300">•</span>
      <a href="#what-to-do" class="text-[#9b1c31] hover:underline font-medium"><%= t('.hero.nav_what_to_do') %></a>
      <span class="text-slate-300">•</span>
      <a href="#how-to-get" class="text-[#9b1c31] hover:underline font-medium"><%= t('.hero.nav_how_to_get') %></a>
      <span class="text-slate-300">•</span>
      <a href="<%= organizer_checklist_path %>" class="text-[#9b1c31] hover:underline font-medium"><%= t('.hero.nav_checklist') %></a>
      <span class="text-slate-300">•</span>
      <a href="<%= embassy_instructions_path %>" class="text-[#9b1c31] hover:underline font-medium"><%= t('.hero.nav_embassy_instructions') %></a>
    </nav>
  </div>
</section>

<!-- Introduction Section -->
<section class="py-16 px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <p class="text-xl text-slate-700 leading-relaxed mb-6">
      <%= t('.intro.paragraph_1') %>
    </p>

    <p class="text-lg text-slate-600 leading-relaxed mb-6">
      <%= t('.intro.paragraph_2') %>
    </p>

    <p class="text-lg text-slate-600 leading-relaxed mb-6">
      <%= t('.intro.paragraph_3_html') %>
    </p>

    <p class="text-lg text-slate-600 leading-relaxed">
      <%= t('.intro.paragraph_4') %>
    </p>
  </div>
</section>

<!-- TL;DR Section -->
<section id="tldr" class="section-alternate py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-8"><%= t('.tldr.heading') %></h2>

    <div class="bg-white rounded-lg p-8 shadow-sm mb-6">
      <p class="text-lg text-slate-700 leading-relaxed mb-4">
        <%= t('.tldr.description') %>
      </p>

      <ol class="space-y-3 text-lg text-slate-700 list-decimal list-inside">
        <li><%= t('.tldr.step_1') %></li>
        <li><%= t('.tldr.step_2') %></li>
        <li><%= t('.tldr.step_3') %></li>
      </ol>
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section id="faq" class="py-20 px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-12"><%= t('.faq.heading') %></h2>

    <div class="space-y-8">
      <div>
        <h3 class="text-xl font-semibold text-slate-800 mb-2"><%= t('.faq.q1') %></h3>
        <p class="text-slate-600 leading-relaxed">
          <%= t('.faq.a1') %>
        </p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-800 mb-2"><%= t('.faq.q2') %></h3>
        <p class="text-slate-600 leading-relaxed">
          <%= t('.faq.a2') %>
        </p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-800 mb-2"><%= t('.faq.q3') %></h3>
        <p class="text-slate-600 leading-relaxed">
          <%= t('.faq.a3') %>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- What to do Section -->
<section id="what-to-do" class="section-alternate py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-8"><%= t('.what_to_do.heading') %></h2>

    <p class="text-xl text-slate-700 leading-relaxed mb-12">
      <%= t('.what_to_do.description') %>
    </p>

    <!-- Have an event stamp -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-slate-800 mb-4"><%= t('.what_to_do.stamp.heading') %></h3>

      <p class="text-lg text-slate-600 leading-relaxed mb-4">
        <%= t('.what_to_do.stamp.paragraph_1') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-4">
        <%= t('.what_to_do.stamp.paragraph_2') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.stamp.paragraph_3') %>
      </p>

      <a href="<%= stamp_samples_path %>" class="inline-flex items-center gap-2 text-[#9b1c31] hover:underline font-medium">
        <span>📋</span>
        <span><%= t('.what_to_do.stamp.samples_link') %></span>
      </a>
    </div>

    <!-- Ensure guests have a passport -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-slate-800 mb-4"><%= t('.what_to_do.ensure_guests.heading') %></h3>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.ensure_guests.paragraph_1') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.ensure_guests.paragraph_2') %>
      </p>

      <div class="bg-white rounded-lg p-6 shadow-sm mb-4">
        <h4 class="text-xl font-semibold text-slate-800 mb-3"><%= t('.what_to_do.ensure_guests.hand_it_heading') %></h4>
        <p class="text-slate-600 leading-relaxed">
          <%= t('.what_to_do.ensure_guests.hand_it_paragraph') %>
        </p>
        <p class="text-slate-600 leading-relaxed mt-3">
          <%= t('.what_to_do.ensure_guests.hand_it_more_html') %>
        </p>
      </div>

      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h4 class="text-xl font-semibold text-slate-800 mb-3"><%= t('.what_to_do.ensure_guests.no_piles_heading') %></h4>
        <p class="text-slate-600 leading-relaxed">
          <%= t('.what_to_do.ensure_guests.no_piles_paragraph_1') %>
        </p>
        <p class="text-slate-600 leading-relaxed mt-3">
          <%= t('.what_to_do.ensure_guests.no_piles_paragraph_2') %>
        </p>
      </div>
    </div>

    <!-- Have a way for guests to print their photos -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-slate-800 mb-4"><%= t('.what_to_do.photos.heading') %></h3>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.photos.paragraph_1') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.photos.paragraph_2') %>
      </p>

      <div class="bg-white rounded-lg p-6 shadow-sm mb-4">
        <h4 class="text-xl font-semibold text-slate-800 mb-3"><%= t('.what_to_do.photos.booth_heading') %></h4>
        <p class="text-slate-600 leading-relaxed mb-3">
          <%= t('.what_to_do.photos.booth_paragraph_1') %>
        </p>
        <p class="text-slate-600 leading-relaxed mb-3">
          <%= t('.what_to_do.photos.booth_paragraph_2') %>
        </p>
        <p class="text-slate-600 leading-relaxed">
          <%= t('.what_to_do.photos.booth_paragraph_3') %>
        </p>
      </div>

      <div class="bg-white rounded-lg p-6 shadow-sm">
        <h4 class="text-xl font-semibold text-slate-800 mb-3"><%= t('.what_to_do.photos.improvise_heading') %></h4>
        <p class="text-slate-600 leading-relaxed mb-3">
          <%= t('.what_to_do.photos.improvise_paragraph_1') %>
        </p>
        <p class="text-slate-600 leading-relaxed mb-3">
          <%= t('.what_to_do.photos.improvise_paragraph_2') %>
        </p>
        <p class="text-slate-600 leading-relaxed font-medium">
          <%= t('.what_to_do.photos.improvise_paragraph_3') %>
        </p>
      </div>
    </div>

    <!-- Have a mock Embassy desk -->
    <div id="embassy" class="mb-16">
      <h3 class="text-2xl font-bold text-slate-800 mb-4"><%= t('.what_to_do.embassy.heading') %></h3>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.embassy.paragraph_1') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.embassy.paragraph_2') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.embassy.paragraph_3') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed">
        <%= t('.what_to_do.embassy.paragraph_4') %>
      </p>
    </div>

    <!-- Mention the Passport in communications -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-slate-800 mb-4"><%= t('.what_to_do.mention_comms.heading') %></h3>

      <p class="text-lg text-slate-600 leading-relaxed mb-4">
        <%= t('.what_to_do.mention_comms.paragraph_1') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed">
        <%= t('.what_to_do.mention_comms.paragraph_2') %>
      </p>
    </div>

    <!-- The stamping booth -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-slate-800 mb-4"><%= t('.what_to_do.stamping_booth.heading') %></h3>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.stamping_booth.paragraph_1_html') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-4 font-semibold">
        <%= t('.what_to_do.stamping_booth.checklist_intro') %>
      </p>

      <ul class="list-disc list-inside space-y-2 text-lg text-slate-600 ml-4">
        <li><%= t('.what_to_do.stamping_booth.checklist_pens') %></li>
        <li><%= t('.what_to_do.stamping_booth.checklist_stamp') %></li>
        <li><%= t('.what_to_do.stamping_booth.checklist_stickers') %></li>
      </ul>
    </div>

    <!-- Mention the Passport on stage -->
    <div class="mb-16">
      <h3 class="text-2xl font-bold text-slate-800 mb-4"><%= t('.what_to_do.mention_stage.heading') %></h3>

      <p class="text-lg text-slate-600 leading-relaxed mb-6">
        <%= t('.what_to_do.mention_stage.paragraph_1') %>
      </p>

      <p class="text-lg text-slate-600 leading-relaxed mb-4 font-semibold">
        <%= t('.what_to_do.mention_stage.things_to_know') %>
      </p>

      <ul class="list-disc list-inside space-y-2 text-lg text-slate-600 ml-4 mb-6">
        <li><%= t('.what_to_do.mention_stage.point_1') %></li>
        <li><%= t('.what_to_do.mention_stage.point_2') %></li>
        <li><%= t('.what_to_do.mention_stage.point_3') %></li>
      </ul>

      <p class="text-lg text-slate-600 leading-relaxed">
        <%= t('.what_to_do.mention_stage.adrian_note') %>
      </p>
    </div>
  </div>
</section>

<!-- How to get Passports Section -->
<section id="how-to-get" class="py-20 px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-8"><%= t('.how_to_get.heading') %></h2>

    <div class="bg-gradient-to-br from-amber-50 to-yellow-50 rounded-lg p-8 border-l-4 border-amber-400">
      <p class="text-lg text-slate-700 leading-relaxed mb-6">
        <%= t('.how_to_get.description') %>
      </p>

      <a href="mailto:adrian@adrianthedev.com" class="inline-flex items-center gap-2 text-xl font-semibold text-[#9b1c31] hover:underline">
        <span>✉️</span>
        <span>adrian@adrianthedev.com</span>
      </a>
    </div>
  </div>
</section>

<%= render "layouts/footer", back_path: root_path, back_label: t("layouts.footer.back_to_home") %>
